{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes.invalid/schemas/domain-fixture.v1.json",
  "title": "Lumi representative domain fixture",
  "type": "object",
  "required": [
    "schema_version", "fixture_id", "domain", "path", "mode", "module",
    "scenario_response", "execution", "expected_semantics", "task", "skills",
    "scoring", "diagnosis", "probe", "teach", "independent_verify",
    "assistance_ladder", "samples", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "hermes.domain-fixture.v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["xingce", "shenlun", "interview"]},
    "path": {"type": "string", "minLength": 1},
    "mode": {"enum": ["success", "ambiguous", "offline"]},
    "module": {"type": "string", "minLength": 1},
    "scenario_response": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object",
      "required": ["connectivity", "cloud_calls_expected", "fallback", "scorer"],
      "properties": {
        "connectivity": {"enum": ["local", "offline"]},
        "cloud_calls_expected": {"type": "integer", "minimum": 0},
        "provider_invoked": {"const": false},
        "fallback": {"enum": ["not_needed", "deterministic_local"]},
        "scorer": {"const": "deterministic_local"}
      }
    },
    "expected_semantics": {
      "type": "object",
      "required": ["score", "cause_status"],
      "properties": {
        "score": {"enum": ["pass", "fail", "deterministic_local"]},
        "cause_status": {"const": "unconfirmed_hypothesis"}
      }
    },
    "task": {
      "type": "object",
      "required": ["prompt", "response_mode"],
      "properties": {"prompt": {"type": "string"}, "response_mode": {"type": "string"}}
    },
    "skills": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["skill_id", "weight"],
        "properties": {"skill_id": {"type": "string"}, "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
      }
    },
    "scoring": {
      "type": "object", "required": ["adapter", "max_score", "pass_score"],
      "properties": {
        "adapter": {"enum": ["xingce_mcq_v1", "shenlun_rubric_v1", "interview_rubric_v1"]},
        "max_score": {"type": "number", "exclusiveMinimum": 0},
        "pass_score": {"type": "number", "minimum": 0}
      }
    },
    "diagnosis": {
      "type": "object", "required": ["semantics", "evidence_catalog", "candidate_causes"],
      "properties": {
        "semantics": {"const": "ranked_unconfirmed_hypotheses"},
        "evidence_catalog": {"type": "array", "minItems": 1},
        "candidate_causes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cause_id", "label", "synthetic_prior", "evidence_refs", "is_ground_truth"],
            "properties": {
              "cause_id": {"type": "string"}, "label": {"type": "string"},
              "synthetic_prior": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "is_ground_truth": {"const": false}
            }
          }
        }
      }
    },
    "probe": {
      "allOf": [
        {"$ref": "#/$defs/promptNode"},
        {
          "type": "object",
          "required": ["targets", "assessment"],
          "properties": {
            "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "assessment": {"$ref": "#/$defs/probeAssessment"}
          }
        }
      ]
    },
    "teach": {"$ref": "#/$defs/teachNode"},
    "independent_verify": {"$ref": "#/$defs/independentVerify"},
    "assistance_ladder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "content_version", "steps"],
      "properties": {
        "schema_version": {"const": "hermes.assistance-content.v1"},
        "content_version": {"type": "string", "minLength": 1},
        "steps": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "title", "content", "target_cause_ids"],
            "properties": {
              "action": {"enum": ["retry", "locate_evidence", "rule_hint", "analogous_example", "worked_step", "full_explanation"]},
              "title": {"type": "string", "minLength": 1},
              "content": {"type": "string", "minLength": 1},
              "target_cause_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object", "required": ["content_origin", "prior_source"],
      "properties": {
        "content_origin": {"const": "synthetic_original"},
        "prior_source": {"type": "string"}
      }
    },
    "samples": {"$ref": "#/$defs/responseSamples"}
  },
  "$defs": {
    "promptNode": {
      "type": "object", "required": ["prompt"],
      "properties": {"prompt": {"type": "string", "minLength": 1}}
    },
    "teachNode": {
      "allOf": [
        {"$ref": "#/$defs/promptNode"},
        {
          "type": "object",
          "required": ["strategy", "variants"],
          "properties": {
            "strategy": {"type": "string", "minLength": 1},
            "variants": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["cause_id", "prompt", "strategy"],
                "properties": {
                  "cause_id": {"type": "string", "minLength": 1},
                  "prompt": {"type": "string", "minLength": 1},
                  "strategy": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      ]
    },
    "independentVerify": {
      "allOf": [
        {"$ref": "#/$defs/promptNode"},
        {
          "type": "object",
          "required": ["response_mode", "pass_condition", "samples"],
          "properties": {
            "response_mode": {"enum": ["single_choice", "short_text", "long_text", "spoken_text"]},
            "pass_condition": {"$ref": "#/$defs/verificationCondition"},
            "samples": {"$ref": "#/$defs/responseSamples"}
          }
        }
      ]
    },
    "responseSamples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passing_response", "failing_response"],
      "properties": {
        "passing_response": {"type": "string", "minLength": 1},
        "failing_response": {"type": "string", "minLength": 1},
        "adversarial_negation_response": {"type": "string", "minLength": 1}
      }
    },
    "verificationCondition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["scorer", "correct_option", "options"],
          "properties": {
            "scorer": {"const": "exact_option_v1"},
            "correct_option": {"type": "string", "minLength": 1},
            "options": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["scorer", "required_dimensions", "minimum_dimensions"],
          "properties": {
            "scorer": {"const": "authored_dimensions_v1"},
            "required_dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimensionGroup"}},
            "minimum_dimensions": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["scorer", "required_slots", "minimum_slots"],
          "properties": {
            "scorer": {"const": "authored_slots_v1"},
            "required_slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slotGroup"}},
            "minimum_slots": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "dimensionGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "aliases"],
      "properties": {
        "dimension_id": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "slotGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "aliases"],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "probeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "evaluator", "cause_samples"],
      "properties": {
        "schema_version": {"const": "hermes.probe-assessment.v1"},
        "evaluator": {"enum": ["authored_terms_v1", "growth_formula_v1"]},
        "cause_map": {
          "type": "object", "additionalProperties": false,
          "required": ["denominator", "increment", "ratio"],
          "properties": {
            "denominator": {"type": "string", "minLength": 1},
            "increment": {"type": "string", "minLength": 1},
            "ratio": {"type": "string", "minLength": 1}
          }
        },
        "cause_samples": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/probeCauseSample"}
        },
        "rules": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cause_id"],
            "properties": {
              "cause_id": {"type": "string", "minLength": 1},
              "support_if": {"$ref": "#/$defs/textCondition"},
              "refute_if": {"$ref": "#/$defs/textCondition"}
            }
          }
        }
      }
    },
    "probeCauseSample": {
      "type": "object", "additionalProperties": false,
      "required": ["cause_id", "supporting_response", "refuting_response", "ambiguous_response"],
      "properties": {
        "cause_id": {"type": "string", "minLength": 1},
        "supporting_response": {"type": "string", "minLength": 1},
        "refuting_response": {"type": "string", "minLength": 1},
        "ambiguous_response": {"type": "string", "minLength": 1}
      }
    },
    "textCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_terms": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}},
        "any_terms": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "none_terms": {"type": "array", "items": {"type": "string", "minLength": 3}}
      }
    }
  }
}

      ],
      "independence_group": "economics-direction-teaching",
      "content_origin": "original_lumi",
      "review_status": "draft_unreviewed",
      "target_candidate_ids": [
        "M-DIRECTION"
      ],
      "teaching_content": "把题干改写成箭头：生产成本下降，是供给侧条件变化；消费者更愿意购买，是需求侧条件变化。先识别主体和变量，再在“其他条件不变”的范围内判断方向，不额外添加题干未给的变化。",
      "record_sha256": "dcd1a2c99fb94e3ae545cd767e4645b9aa268c729ae735ce34263189504418f5"
    },
    {
      "record_id": "T-INDICATOR",
      "role": "teaching_asset",
      "title": "微课：局部情境不能自动变成宏观指标",

      "content_origin": "original_lumi",
      "review_status": "draft_unreviewed",
      "target_candidate_ids": [
        "M-INDICATOR"
      ],
      "teaching_content": "题干只给一个市场、一个商品或一段关系时，结论也先停在该范围。价格总水平、产出等总体指标需要额外定义和数据；不能从一个局部变化直接写出宏观结论。",
      "record_sha256": "915edfb23f15bb286eab68825f461ce92ca166f4d9fa944d3e704d9a6beebba5"
    },

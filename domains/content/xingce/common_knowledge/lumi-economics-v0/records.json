      "role": "teaching_asset",
      "title": "微课：先写清“谁在变、什么在变”",
      "target_skill_ids": [
        "xingce.common.economics.concept_boundary",
        "xingce.common.economics.mechanism_direction"
      ],
      "candidate_misconception_ids": [

    {
      "record_id": "D01",
      "role": "entry_diagnostic",
      "title": "只有：从结果回推必要条件",
      "prompt": "在本题设定中，园区严格执行规则（不考虑违规领取、记录错误或系统故障）：只有完成门禁登记，才能领取工作牌。小周已经领取工作牌。以下哪项一定为真？",
      "response_mode": "single_choice",
      "assessment_format": "conclusion_selection",
      "options": {
        "A": "小周已经完成门禁登记。",
        "B": "任何完成门禁登记的人都已经领取工作牌。",
        "C": "小周领取工作牌是因为他认识园区工作人员。",
        "D": "小周无需完成门禁登记也能领取工作牌。"
      },
      "correct_option": "A",
      "formalization": "badge_collected -> registration_completed; badge_collected; therefore registration_completed",
      "answer_proof": "题设中的必要条件形式为领取工作牌→完成登记；已知前件成立，应用肯定前件式推出后件成立。",
      "distractor_map": {
        "B": "converse",
        "C": "unsupported_premise",
        "D": "contradicts_rule"
      },
      "target_skill_ids": [
        "xingce.judgment.conditional.language_direction",
        "xingce.judgment.conditional.necessary_sufficient_role"
      ],
      "candidate_misconception_ids": [
        "M-DIR",
        "M-ROLE",
        "M-READ"
      ],
      "independence_group": "entry-direction-01",
      "content_origin": "original_lumi",
      "review_status": "draft_unreviewed",
      "record_sha256": "a9f6d4c4a543bc2831ab0867b3b9ab8eb0c4c6a9486afb86c6cceffe41f9f830"

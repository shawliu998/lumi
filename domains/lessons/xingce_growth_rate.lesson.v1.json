  "version": "1.0.0",
  "domain": "xingce",
  "path": "data_analysis",
  "module": "资料分析/增长率",
  "title": "增长率：先找比较起点",
  "estimated_minutes": 8,
  "skill_ids": [
    "xingce.data.growth.compute-rate"
  ],
  "method_card": {
    "definition": "增长率表示同一指标从基期到现期的相对变化程度；结果为负时表示下降。",
    "formula": "增长率 = (现期量 - 基期量) / 基期量 × 100%",
    "applicability": [
      "题目给出同一指标在两个可比时点的数值",
      "两个数值的统计口径与单位一致"
    ],
    "common_mistake": {
      "label": "把现期量放在分母",
      "explanation": "增长率要回答变化相对于起点有多大，因此分母应是变化发生前的基期量。"
    }
  },
  "worked_example": {
    "example_id": "growth-rate-worked-original-01",
    "prompt": "某社区科普馆周末接待人数由210人增至252人，增长率是多少？",
    "steps": [
      {
        "step_id": "label-periods",
        "instruction": "标记两个时点",
        "content": "基期量是210，现期量是252。"
      },
      {
        "step_id": "compute-change",
        "instruction": "先求变化量",
        "content": "变化量为252 - 210 = 42。"
      },
      {
        "step_id": "compare-with-base",
        "instruction": "用变化量比较起点",
        "content": "42 / 210 = 0.20。"
      },
      {
        "step_id": "interpret",
        "instruction": "化成百分数并解释",
        "content": "增长率为20%，表示新增人数相当于基期人数的20%。"
      }
    ],
    "hint_ladder": [
      {
        "level": 1,
        "label": "找起点",
        "prompt": "先不计算：210与252中，哪一个是变化发生前的量？",
        "reveal_rank": 1
      },
      {
        "level": 2,
        "label": "求变化",
        "prompt": "先用现期量减去基期量，再想这个差应与哪个时点比较。",
        "reveal_rank": 2
      },
      {
        "level": 3,
        "label": "给公式框架",
        "prompt": "把变化量放在分子、基期量放在分母：请代入(252 - 210) / 210。",
        "reveal_rank": 3
      }
    ],
    "answer": "20%"
  },

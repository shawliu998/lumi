{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/schemas/practice-bank-manifest.v3.json",
  "title": "Lumi generated practice bank manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_id",
    "version",
    "generator_version",
    "status",
    "expected_question_count",
    "expected_module_counts",
    "generated_sha256",
    "content_sources"
  ],
  "properties": {
    "schema_version": { "const": "lumi.practice-bank-manifest.v3" },
    "bank_id": { "const": "lumi.xingce.core-320.practice-v3" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generator_version": { "type": "string", "minLength": 1 },
    "status": { "const": "published_internal" },
    "expected_question_count": { "const": 320 },
    "expected_module_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xingce.verbal.core",
        "xingce.judgment.core",
        "xingce.quantitative.core",
        "xingce.data-analysis.core"
      ],
      "properties": {
        "xingce.verbal.core": { "const": 80 },
        "xingce.judgment.core": { "const": 80 },
        "xingce.quantitative.core": { "const": 80 },
        "xingce.data-analysis.core": { "const": 80 }
      }
    },
    "generated_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content_sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_source_id",
          "content_origin",
          "reference_title",
          "reference_page_range",
          "covered_modules",
          "source_use",
          "source_text_included",
          "rights_status",
          "authorization_status",
          "review_status",
          "authored_at"
        ],
        "properties": {
          "content_source_id": {
            "enum": [
              "src.lumi.core320.wen-structure",
              "src.lumi.core320.li-structure"
            ]
          },
          "content_origin": { "const": "synthetic_original" },
          "reference_title": { "type": "string", "minLength": 1 },
          "reference_page_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pdf_start", "pdf_end", "printed_start", "printed_end"],
            "properties": {
              "pdf_start": { "type": "integer", "minimum": 1 },
              "pdf_end": { "type": "integer", "minimum": 1 },
              "printed_start": { "type": "integer", "minimum": 1 },
              "printed_end": { "type": "integer", "minimum": 1 }
            }
          },
          "covered_modules": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "xingce.verbal.core",
                "xingce.judgment.core",
                "xingce.quantitative.core",
                "xingce.data-analysis.core"
              ]
            }
          },
          "source_use": { "const": "concept_structure_reference" },
          "source_text_included": { "const": false },
          "rights_status": { "const": "rights_review_required" },
          "authorization_status": { "const": "internal_mvp_only" },
          "review_status": { "const": "human_review_required_before_external_release" },
          "authored_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}

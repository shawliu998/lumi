    {
      "record_id": "T-ORDER",
      "role": "teaching_asset",
      "title": "微课：目标—方案—执行—检查—调整",
      "target_skill_ids": [
        "xingce.common.management.process"
      ],
      "candidate_misconception_ids": [
        "M-ORDER"
      ],
      "independence_group": "management-teaching",
      "content_origin": "original_lumi",
      "review_status": "release_ready",
      "target_candidate_ids": [
        "M-BOUND",
        "M-ORDER",
        "M-ROLE"
      ],
      "teaching_content": "先把管理过程拆成四类：目标是希望达到的结果指标，方案与执行是行动，记录与检查是证据，反馈用于后续调整。通常先界定目标，再制定和执行方案；执行人员记录现场信息，协调者依据记录检查并调整。不要把措施当目标、把记录当结论，或让检查早于执行。",
      "record_sha256": "a756b7fc5c1bba2a050e1a16eaf1ac778f45fae7bb80b86ac136cc692176bb8e"
    },

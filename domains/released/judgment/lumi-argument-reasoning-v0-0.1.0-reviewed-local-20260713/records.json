      "content_origin": "original_lumi",
      "review_status": "release_ready",
      "prompt": "某服务大厅在入口增加了流程提示牌后，一个月内填错表格的次数下降。负责人据此认为，提示牌是填错次数下降的原因。下列哪项如果为真，最能削弱该结论？",
      "response_mode": "single_choice",
      "options": [
        {
          "label": "A",
          "text": "同月启用了自动校验系统，会在提交前提示缺项"
        },
        {
          "label": "B",
          "text": "提示牌使用了较大的字体"
        },
        {
          "label": "C",
          "text": "有些使用者表示愿意阅读提示牌"
        },
        {
          "label": "D",
          "text": "入口比以前更整洁"
        }
      ],
      "correct_option": "A",
      "route_probe_ids": [
        "P01"
      ],
      "record_sha256": "c200f473a3230b70b28214ebf940b27e8c92b640a37e9f32651bc2434d3bfcc2"
    },

      "independence_group": "text-scope-teaching",
      "content_origin": "original_lumi",
      "review_status": "release_ready",
      "target_candidate_ids": [
        "M-SCOPE"
      ],
      "teaching_content": "问“2024年占比”时，分子和分母都必须来自2024年。把每个数字旁边标上年份；只要一个数字没有同样的年份标签，就先不要相除。",
      "record_sha256": "9ac4be17e1ea6f5161a923471a666cf32133049b8be9ba7157082b85192e112b"
    },
    {
      "record_id": "T-DEN",

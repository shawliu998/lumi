{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/contracts/study-verifier-decision.schema.json",
  "title": "Lumi Study Pack verifier decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "pack_id",
    "artifact_id",
    "artifact_version",
    "artifact_digest",
    "verifier_id",
    "accepted",
    "reason_codes"
  ],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^v_[A-P]{40}$"},
    "pack_id": {"type": "string", "pattern": "^p_[A-P]{40}$"},
    "artifact_id": {"type": "string", "pattern": "^a_[A-P]{40}$"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "artifact_digest": {"$ref": "#/$defs/sha256"},
    "verifier_id": {"const": "study-pack-deterministic-verifier@1"},
    "accepted": {"type": "boolean"},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/contracts/review-schedule.schema.json",
  "title": "Lumi ReviewSchedule response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "count",
    "items",
    "authority",
    "mastery_write_capability",
    "population_evidence"
  ],
  "properties": {
    "schema_version": {"const": "lumi.review-schedule.v1"},
    "count": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "authority": {"const": "independent_review_schedule_projection"},
    "mastery_write_capability": {"const": false},
    "population_evidence": {"const": "unavailable"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "source_key",
        "task_kind",
        "domain",
        "skill_id",
        "reason",
        "expected_duration_minutes",
        "success_criterion",
        "skip_consequence",
        "evidence_refs",
        "activity_ref",
        "cause_id",
        "cause_label",
        "cause_confirmation_status",
        "definition_status",
        "policy_offset_days",
        "base_due_on",
        "initial_due_on",
        "scheduling_adjustment",
        "schedule_window",
        "completion_semantics",
        "state",
        "due_on",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {"const": "lumi.review-schedule.v1"},
        "task_id": {"type": "string", "pattern": "^review-[0-9a-f]{24}$"},
        "source_key": {"type": "string", "pattern": "^(cause|skill):[0-9a-f]{64}$"},
        "task_kind": {"enum": ["cause_probe", "independent_retry", "delayed_retention"]},
        "domain": {"enum": ["xingce", "shenlun", "interview"]},
        "skill_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "expected_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
        "success_criterion": {"type": "string", "minLength": 1},
        "skip_consequence": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
        "activity_ref": {"$ref": "#/$defs/activity_ref"},
        "cause_id": {"type": ["string", "null"]},
        "cause_label": {"type": ["string", "null"]},
        "cause_confirmation_status": {"type": ["string", "null"], "enum": [null, "unconfirmed"]},
        "definition_status": {"const": "authored_engineering_estimate_unvalidated"},
        "policy_offset_days": {"type": "integer", "enum": [1, 3]},
        "base_due_on": {"$ref": "#/$defs/date"},
        "initial_due_on": {"$ref": "#/$defs/date"},
        "scheduling_adjustment": {"enum": ["on_policy_window", "overdue_catch_up"]},
        "schedule_window": {"$ref": "#/$defs/schedule_window"},
        "completion_semantics": {"type": ["string", "null"], "enum": [null, "user_marked_not_learning_evidence"]},
        "state": {"enum": ["scheduled", "accepted", "completed", "postponed", "skipped"]},
        "due_on": {"$ref": "#/$defs/date"},
        "version": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1}
      }
    },
    "activity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "fixture_content_sha256", "availability", "launch_method", "launch_endpoint", "launch_schema_version", "novelty_status"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "fixture_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "availability": {"const": "launchable"},
        "launch_method": {"const": "POST"},
        "launch_endpoint": {"const": "/v1/attempts"},
        "launch_schema_version": {"const": "hermes.attempt-session.v1"},
        "novelty_status": {"const": "same_fixture_retest_not_novel_item"}
      }
    },
    "schedule_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_offset_days", "base_due_on", "initial_due_on", "scheduling_adjustment", "calibration", "exam_adjustment"],
      "properties": {
        "policy_offset_days": {"type": "integer", "enum": [1, 3]},
        "base_due_on": {"$ref": "#/$defs/date"},
        "initial_due_on": {"$ref": "#/$defs/date"},
        "scheduling_adjustment": {"enum": ["on_policy_window", "overdue_catch_up"]},
        "calibration": {"const": "fixed_engineering_policy_unvalidated"},
        "exam_adjustment": {"const": "withhold_if_due_after_exam"}
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "source_type", "run_id", "event_seq", "event_hash", "event_kind", "json_pointer", "semantic", "subject_id", "phase", "claim_status", "confirmation_status"],
      "properties": {
        "ref": {"type": "string", "pattern": "^trace:"},
        "kind": {"enum": ["trace_observation", "trace_skill_evidence", "candidate_cause", "trace_terminal"]},
        "source_type": {"const": "trace_event"},
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,96}$"},
        "event_seq": {"type": "integer", "minimum": 1},
        "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_kind": {"type": "string", "minLength": 1},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "semantic": {"enum": ["verification_effective", "initial_answer_passed", "candidate_hypothesis", "candidate_claim_status", "terminal_completed"]},
        "subject_id": {"type": ["string", "null"]},
        "phase": {"type": ["string", "null"]},
        "claim_status": {"type": ["string", "null"], "enum": [null, "unconfirmed_hypothesis", "supported_hypothesis"]},
        "confirmation_status": {"type": ["string", "null"], "enum": [null, "unconfirmed"]}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes/contracts/release-report-v1.json",
  "title": "Lumi release gate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "repository", "overall_status", "summary", "gates"],
  "properties": {
    "schema_version": {"type": "string", "const": "release-report-v1"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "repository": {"type": "string"},
    "overall_status": {"type": "string", "enum": ["pass", "fail", "pending"]},
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "pending", "total"],
      "properties": {
        "pass": {"type": "integer"},
        "fail": {"type": "integer"},
        "pending": {"type": "integer"},
        "total": {"type": "integer"}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "summary", "evidence", "blocking", "duration_ms"],
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "pending"]},
          "summary": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "blocking": {"type": "boolean"},
          "duration_ms": {"type": "integer"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes/contracts/representative-case-v1.json",
  "title": "Lumi representative evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "domain", "path", "mode", "fixture_version", "input", "expectations"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "enum": ["xingce", "shenlun", "interview"]},
    "path": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["success", "ambiguous", "offline"]},
    "fixture_version": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "expectations": {
      "type": "object",
      "required": ["required_evidence", "must_not_claim"],
      "properties": {
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "must_not_claim": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/contracts/study-artifact.schema.json",
  "title": "Lumi public Study Pack artifact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "pack_id",
    "artifact_version",
    "artifact_type",
    "lifecycle",
    "content_digest",
    "generator_id",
    "generator_metadata"
  ],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^a_[A-P]{40}$"},
    "pack_id": {"type": "string", "pattern": "^p_[A-P]{40}$"},
    "artifact_version": {"type": "integer", "minimum": 1},
    "artifact_type": {
      "enum": [
        "study_pack.one_page_notes",
        "study_pack.knowledge_card",
        "study_pack.practice_item",
        "study_pack.review_task"
      ]
    },
    "lifecycle": {"enum": ["draft", "review", "published", "quarantined"]},
    "content_digest": {"$ref": "#/$defs/sha256"},
    "generator_id": {"const": "extractive-local@1"},
    "generator_metadata": {"$ref": "#/$defs/generator_metadata"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id",
        "mode",
        "model_calls",
        "network_calls",
        "ocr_calls",
        "source_normalized_sha256"
      ],
      "properties": {
        "generator_id": {"const": "extractive-local@1"},
        "mode": {"const": "deterministic_extractive"},
        "model_calls": {"const": 0},
        "network_calls": {"const": 0},
        "ocr_calls": {"const": 0},
        "source_normalized_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

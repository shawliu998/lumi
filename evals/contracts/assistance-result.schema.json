{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lumi.invalid/schemas/assistance-result.v1.json",
  "title": "Lumi progressive assistance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "state",
    "state_version",
    "prompt_instance_id",
    "assistance",
    "remaining_levels",
    "idempotent_replay",
    "trace_verified",
    "links"
  ],
  "properties": {
    "schema_version": {"const": "hermes.assistance-result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"const": "awaiting_probe"},
    "state_version": {"type": "integer", "minimum": 1},
    "prompt_instance_id": {"type": "string", "minLength": 1},
    "assistance": {
      "allOf": [
        {"$ref": "#/$defs/assistance"}
      ]
    },
    "remaining_levels": {"type": "integer", "minimum": 0, "maximum": 5},
    "idempotent_replay": {"type": "boolean"},
    "trace_verified": {"const": true},
    "links": {"$ref": "#/$defs/links"}
  },
  "$defs": {
    "assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "action",
        "title",
        "content",
        "target_cause_ids",
        "content_version",
        "policy_version",
        "diagnostic_evidence_weight",
        "calibration_status",
        "phase",
        "independence_effect"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
        "action": {
          "enum": [
            "retry",
            "locate_evidence",
            "rule_hint",
            "analogous_example",
            "worked_step",
            "full_explanation"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "target_cause_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1}
        },
        "content_version": {"type": "string", "minLength": 1},
        "policy_version": {"const": "assistance-evidence-policy.v1"},
        "diagnostic_evidence_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "calibration_status": {"const": "engineering_policy_unvalidated"},
        "phase": {"const": "probe"},
        "independence_effect": {"const": "discounts_probe_evidence"}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["respond", "misconception", "trace"],
      "properties": {
        "respond": {"type": "string", "pattern": "^/v1/attempts/"},
        "misconception": {"type": "string", "pattern": "^/v1/misconceptions/"},
        "trace": {"type": "string", "pattern": "^/v1/runs/"}
      }
    }
  }
}
